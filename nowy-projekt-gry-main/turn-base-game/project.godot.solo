; KOPIA ustawień projektu walki (TurnBaseGame).
; NIE nazywaj tego pliku project.godot w tym folderze — Godot wtedy
; pomija cały turn-base-game/ (edytor + eksport Web) i walka znika z res://.
;
; Solo: otwórz projekt GŁÓWNY (nowy-projekt-gry-main) i uruchom scenę
; res://turn-base-game/gra.tscn (F6 / Run Specific Scene).
;
; Format: standardowy project.godot Godota 4.

config_version=5

[application]

config/name="TurnBaseGame"
config/version="0.1.0"
run/main_scene="res://turn-base-game/gra.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=144
config/icon="res://icon.svg"
config/build_date="2026-07-21"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/stretch/mode="canvas_items"

[gui]

timers/tooltip_delay_sec=0.0
theme/custom="res://turn-base-game/theme/georgia_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
